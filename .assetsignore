# ============================================================
#  웹으로 서비스하지 않을 파일 (.gitignore 와 같은 문법)
#
#  저장소에는 그대로 남습니다. 배포되는 사이트에만 안 올라갑니다.
#  게임 화면은 .md / .bat 을 전혀 참조하지 않으므로 빼도 안전합니다.
# ============================================================

# 기획서 · 가이드 · README
*.md

# 로컬 실행용 배치 파일 (웹에서는 쓸 일이 없습니다)
*.bat

# 개발용 검사 도구 (simtest / uicheck / playtest)
tools/

# 배포 설정 자신과 저장소 메타
wrangler.jsonc
.assetsignore
.gitattributes
.gitignore

# 개발 중 임시 설치물
node_modules/

# Worker 서버 소스는 정적 웹 자산으로 직접 노출하지 않음
worker.js

# Codex/agent 작업 메타
.codex/
.agents/.wrangler/

# 저장소·로컬 빌드 산출물
.git/
.wrangler/
_deploy/
.agents/
