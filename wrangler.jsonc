{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drb-decision-journey",
  "main": "./worker.js",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_SESSION",
        "class_name": "GameSession"
      },
      {
        "name": "REQUEST_GATE",
        "class_name": "RequestGate"
      }
    ]
  },
  "exports": {
    "GameSession": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "RequestGate": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
