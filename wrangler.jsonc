{
  // ============================================================
  //  Cloudflare Workers 배포 설정
  //
  //  이 게임은 서버 코드가 없는 순수 정적 사이트입니다.
  //  그래서 "main"(워커 스크립트) 없이 "assets"만 지정합니다.
  //
  //  main 브랜치에 push 하면 Cloudflare 가 이 파일을 읽고
  //  약 1분 뒤 사이트에 자동 반영됩니다.
  // ============================================================

  "name": "drb-decision-journey",
  "compatibility_date": "2026-08-12",

  "assets": {
    // 저장소 최상단이 곧 사이트 루트입니다 (index.html 이 여기 있습니다).
    // 웹에 올리지 않을 파일은 .assetsignore 에 적습니다.
    "directory": "./"
  }
}
